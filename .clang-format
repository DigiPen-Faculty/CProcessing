# The house style of CProcessing's own code (the library, examples,
# templates and tests): tabs, braces on their own lines, `Type* name`.
# CI checks it (the `format` job in .github/workflows/tests.yml), so a pull
# request that isn't formatted fails; to format what you changed, run
#
#     pip install clang-format==23.1.5
#     clang-format -i <the files you changed>
#
# The version is pinned because clang-format's output changes a little between
# versions; use the same one as CI (the workflow's CLANG_FORMAT_VERSION).
#
# Vendored and third-party code (NanoVG, GLAD, stb, SoLoud, GLFW, Unity, vect)
# keeps its upstream style so that updates stay easy to compare (see
# DEPENDENCIES.md), the public headers are aligned by hand in columns, and
# Internal_Resources.h is embedded font data: all are listed in
# .clang-format-ignore.
#
# For a table that reads better in columns than reflowed, wrap it in
#     // clang-format off
#     ...
#     // clang-format on
BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
TabWidth: 4
# Tabs for indentation and for continuation lines; spaces to align a trailing
# comment or a column
UseTab: ForContinuationAndIndentation
ContinuationIndentWidth: 4
AlignAfterOpenBracket: DontAlign
ColumnLimit: 0
# Allman: a brace on its own line, except `extern "C" {`
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeWhile: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
PointerAlignment: Left
IndentCaseLabels: false
# `{ 0 }`, not `{0}`
Cpp11BracedListStyle: false
SpaceBeforeParens: ControlStatements
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: All
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: true
AlignConsecutiveShortCaseStatements:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignConsecutiveMacros: AcrossComments
AlignArrayOfStructures: Left
AlignTrailingComments: true
# Indentation shows how #if blocks nest
IndentPPDirectives: BeforeHash
# Include order matters here (windows.h and GLAD before GLFW)
SortIncludes: Never
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false
# A file ends with a newline (clang and gcc -Wpedantic say so if it doesn't)
InsertNewlineAtEOF: true
